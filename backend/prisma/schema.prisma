generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Brew {
  id           Int      @id @default(autoincrement())
  name         String
  method       String
  grindSize    String
  waterAmount  Float
  coffeeAmount Float
  brewTime     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}